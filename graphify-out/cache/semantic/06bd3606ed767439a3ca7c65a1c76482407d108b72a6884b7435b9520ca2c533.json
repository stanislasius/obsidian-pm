{"nodes": [{"id": "gantt_gantttaskbarrenderer_rendertaskbar", "label": "renderTaskBar", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/gantt/GanttTaskBarRenderer.ts", "source_location": 22, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task with end date E occupies the day E, so the bar right edge sits at the start of E+1. Completed portion is a solid fill over a faint track (opacity 0.4 base / 0.9 progress) so progress reads at a glance. Wires resize handles, link dots, move-drag and click-to-open; dragMoved suppresses the click that follows a drag."}, {"id": "gantt_gantttaskbarrenderer_renderemptyrowclicktarget", "label": "renderEmptyRowClickTarget", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/gantt/GanttTaskBarRenderer.ts", "source_location": 214, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invisible full-row hit area for tasks without dates; mouse-tracking preview bar snapped to day grid, click sets start=due=clicked date via store.updateTask + scheduleAfterChange."}, {"id": "gantt_gantttaskbarrenderer_renderdependencarrows", "label": "renderDependencyArrows", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/gantt/GanttTaskBarRenderer.ts", "source_location": 365, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws curved bezier arrows from each dependency's due (start of due+1) to the successor's start, with a reusable pm-arrowhead marker in <defs>."}, {"id": "gantt_gantttaskbarrenderer_rendermilestonelabels", "label": "renderMilestoneLabels", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/gantt/GanttTaskBarRenderer.ts", "source_location": 321, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationa