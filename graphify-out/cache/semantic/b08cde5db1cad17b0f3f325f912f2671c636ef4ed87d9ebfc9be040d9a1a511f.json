{"nodes": [{"id": "table_tablerenderer_rendertable", "label": "renderTable", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 53, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds the table shell, sortable headers (built-in columns plus dynamic custom-field columns), select-all checkbox and wires the scroll handler. The scroll handler repaints only when the visible window actually moved \u2014 rebuilding the tbody can itself nudge scrollTop (clamping near the edges), which fires another scroll event; without this guard it would feed back into an endless repaint loop."}, {"id": "table_tablerenderer_refreshtablebody", "label": "refreshTableBody", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 160, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-runs filter/sort/grouping and the virtual window without rebuilding the table shell."}, {"id": "table_tablerenderer_filltablebody", "label": "fillTableBody", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 166, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-groups tasks by parentId in one O(N) tree walk instead of O(N^2); orphans whose parent got filtered out are promoted to root. Sorts each sibling bucket, emits the stable tree order and repaints the window."}, {"id": "table_tablerenderer_computewindow", "label": "computeWindow", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 225, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes the [start,end) slice of visibleRows for the current scroll position with ROW_OVERSCAN=8 padding."}, {"id": "table_tablerenderer_renderwindowrows", "label": "renderWindowRows", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 245, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders only the rows inside the scroll viewport (plus overscan) bracketed by spacer rows sized to keep the scrollbar honest \u2014 render cost is O(viewport), independent of project size. Row height starts as ROW_HEIGHT_ESTIMATE and is calibrated exactly once against a real painted row because re-calibrating every pass feeds back into the window math and can oscillate forever. Always repaints when data changed by forcing windowStart=-1."}, {"id": "table_tablerenderer_handletablekeydown", "label": "handleTableKeyDown", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 305, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard navigation for the table: Escape clears selection/edits, j/k (and arrows) move single-row selection, Enter/e opens the task modal, Delete/Backspace bulk-deletes or deletes the focused row."}, {"id": "table_tablerenderer_updateselectcheckboxes", "label": "updateSelectCheckboxes", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 291, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors selectedTaskIds onto every rendered row checkbox then syncs the select-all checkbox."}, {"id": "table_tablerenderer_getvisibletaskids", "label": "getVisibleTaskIds", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 385, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered task-id list of the currently visible (filtered/sorted/collapsed) rows \u2014 the source of truth for the virtual window and keyboard/selection operations."}, {"id": "table_tablerenderer_tablestate", "label": "TableState", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 16, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutable render state created once per TableView and threaded through every table renderer: sort key/dir, filter, selection sets, virtual-window bounds, and the renderWindow callback."}, {"id": "table_tablerenderer_tablecontext", "label": "TableContext", "file_type": "code", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 39, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-render context built by TableView.makeTableContext: container, project, resolved statuses/priorities, TableState and refresh/selection callbacks; consumed by renderTable, renderTaskRow and the bulk action bar."}], "edges": [{"source": "table_tablerenderer_rendertable", "target": "table_tablerenderer_filltablebody", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 157, "weight": 1.0}, {"source": "table_tablerenderer_rendertable", "target": "table_tablerenderer_refreshtablebody", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/src/views/table/TableRenderer.ts", "source_location": 121, "weight": 1.0}, {"source": "table_tablerenderer_rendertable", "target": "table_tablerenderer_computewindow", "relation": "calls", "confidence": "E