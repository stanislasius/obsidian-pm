{"nodes": [{"id": "plans_fix_task_templates_race_plan", "label": "Fix: task templates race condition", "file_type": "document", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/.opencode/plans/fix-task-templates-race.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_fix_task_templates_race_await_before_render", "label": "Await async loads before first render", "file_type": "rationale", "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/.opencode/plans/fix-task-templates-race.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TaskModal.onOpen called loadTemplates() without awaiting, so render() ran against an emptied taskTemplates array (loadTemplates sync-empties before its first await), hiding templates and letting an in-flight scan clobber a just-saved template. Fix: await loadTemplates in an init() before the first render(); render() is idempotent and disk refresh is preserved."}], "edges": [{"source": "plans_fix_task_templates_race_plan", "target": "store_projectstore_loadtemplates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/.opencode/plans/fix-task-templates-race.md", "source_location": null, "weight": 1.0}, {"source": "plans_fix_task_templates_race_plan", "target": "modals_taskmodal_onopen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/.opencode/plans/fix-task-templates-race.md", "source_location": null, "weight": 1.0}, {"source": "plans_fix_task_templates_race_plan", "target": "session_summary_templates_as_files", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "/home/stanislasius/Projects/Personal/obsidian-pm/.opencode/plans/fix-task-t